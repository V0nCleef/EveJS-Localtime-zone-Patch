  "supportedBackends": [
    "native"
  ],
  "activation": {
    "strategy": "loader_rename"
  },
  "restart": "game_server",
  "compatibility": {
    "evejsVersions": [
      "0.12.9",
      "261018.1",
      "261028.1",
      "261108.1",
      "261115.2",
      "261125.3",
      "261126.2"
    ]
  },
  "updates": {
    "provider": "github",
    "repository": "V0nCleef/EveJS-Localtime-zone-Patch",
    "asset": "EveJS-Localtime-zone-Patch-{version}.zip",
    "channel": "stable",
    "tagPrefix": "v"
  }
}
